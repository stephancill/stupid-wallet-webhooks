OPERATOR_SECRET=change-me
API_KEY_PEPPER=change-me
WEBHOOK_SIGNING_MASTER=change-me
# Local-only: set to 1 to allow loopback webhook URLs for integration tests.
ALLOW_INSECURE_TEST_WEBHOOKS=0
# If set, the scanner uses rpc-racer's private /internal route (low fan-out).
RPC_INTERNAL_SECRET=
RPC_SCANNER_FANOUT=2
# Max D1 cursor persistence cadence in ms (coalesces cursor writes on fast chains).
# SCANNER_CURSOR_D1_MS=8000
# Consecutive unresolvable scans before auto resync (default 3). 
# SCANNER_UNRESOLVABLE_LIMIT=3
# Blocks behind head to re-anchor at when a cursor is unrecoverable (default 64).
# SCANNER_REANCHOR_DEPTH_BLOCKS=64
# Skip a block after N consecutive failures (0 disables; default 5).
# SCANNER_SKIP_BLOCK_FAILURES=5